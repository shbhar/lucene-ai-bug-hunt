---------------------------------- MODULE MC ----------------------------------
EXTENDS AddIndexesMergeSource
CONSTANTS c1, c2, x1
S_1c == {c1}
S_2c == {c1, c2}
NM_1 == [c \in {c1} |-> 1]
NM_2 == [c \in {c1} |-> 2]
NM_11 == [c \in {c1, c2} |-> 1]
NM_21 == [c \in {c1, c2} |-> IF c = c1 THEN 2 ELSE 1]
X_0 == {}
X_1 == {x1}
===============================================================================
