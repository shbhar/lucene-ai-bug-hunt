; expected: unsat
(set-logic QF_FPBV)
(set-option :produce-models true)
(declare-const va (_ FloatingPoint 8 24))
(declare-const ba (_ BitVec 32))
(declare-const oa (_ BitVec 32))
(assert (= va ((_ to_fp 8 24) ba)))
(define-fun ca () (_ BitVec 32) (ite (fp.isNaN va) #x7fc00000 ba))
(assert (bvsge oa #x00000000))
(declare-const vb (_ FloatingPoint 8 24))
(declare-const bb (_ BitVec 32))
(declare-const ob (_ BitVec 32))
(assert (= vb ((_ to_fp 8 24) bb)))
(define-fun cb () (_ BitVec 32) (ite (fp.isNaN vb) #x7fc00000 bb))
(assert (bvsge ob #x00000000))
(declare-const vc (_ FloatingPoint 8 24))
(declare-const bc (_ BitVec 32))
(declare-const oc (_ BitVec 32))
(assert (= vc ((_ to_fp 8 24) bc)))
(define-fun cc () (_ BitVec 32) (ite (fp.isNaN vc) #x7fc00000 bc))
(assert (bvsge oc #x00000000))
(assert (distinct oa ob))
(assert (distinct oa oc))
(assert (distinct ob oc))

(define-fun LT_Q ((x (_ FloatingPoint 8 24)) (ox (_ BitVec 32)) (y (_ FloatingPoint 8 24)) (oy (_ BitVec 32))) Bool
  (ite (fp.lt x y) true (ite (fp.gt x y) false (bvsgt ox oy))))
(define-fun JCMP ((x (_ FloatingPoint 8 24)) (cx (_ BitVec 32)) (y (_ FloatingPoint 8 24)) (cy (_ BitVec 32))) (_ BitVec 2)
  (ite (fp.lt x y) #b11 (ite (fp.gt x y) #b01 (ite (= cx cy) #b00 (ite (bvslt cx cy) #b11 #b01)))))
(define-fun LT_FIX ((x (_ FloatingPoint 8 24)) (cx (_ BitVec 32)) (ox (_ BitVec 32)) (y (_ FloatingPoint 8 24)) (cy (_ BitVec 32)) (oy (_ BitVec 32))) Bool
  (ite (= (JCMP x cx y cy) #b00) (bvsgt ox oy) (= (JCMP x cx y cy) #b11)))
(define-fun BEFORE_ALL ((x (_ FloatingPoint 8 24)) (nx (_ BitVec 32)) (y (_ FloatingPoint 8 24)) (ny (_ BitVec 32))) Bool
  (ite (fp.gt x y) true (ite (fp.gt y x) false (bvslt nx ny))))
(define-fun BEFORE_TOP ((x (_ FloatingPoint 8 24)) (cx (_ BitVec 32)) (nx (_ BitVec 32)) (y (_ FloatingPoint 8 24)) (cy (_ BitVec 32)) (ny (_ BitVec 32))) Bool
  (ite (= (JCMP x cx y cy) #b01) true (ite (= (JCMP x cx y cy) #b11) false (bvslt nx ny))))
(assert (not (fp.isNaN va)))
(assert (not (fp.isNaN vb)))
(assert (not (fp.isNaN vc)))
(assert (LT_Q va oa vb ob))
(assert (LT_Q vb ob vc oc))
(assert (not (LT_Q va oa vc oc)))
(check-sat)
