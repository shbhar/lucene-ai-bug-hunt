+  public void testEscapedCharRange() {
+    RegExp re = new RegExp("[\\.-z]");
+    assertEquals("REGEXP_CHAR_RANGE from=. to=z\n", re.toStringTree());
+
+    Automaton actual = re.toAutomaton();
+    AutomatonTestUtil.assertMinimalDFA(actual);
+
+    Automaton expected = Automata.makeCharRange('.', 'z');
+    assertSameLanguage(expected, actual);
+  }
+
+  public void testEscapedCharRangeEndingInDash() {
+    RegExp re = new RegExp("[\\!--]");
+    assertEquals("REGEXP_CHAR_RANGE from=! to=-\n", re.toStringTree());
+
+    Automaton expected = Automata.makeCharRange('!', '-');
+    assertSameLanguage(expected, re.toAutomaton());
+  }
