+package org.apache.lucene.search;
+
+import java.io.IOException;
+import org.apache.lucene.document.Document;
+import org.apache.lucene.document.Field;
+import org.apache.lucene.document.TextField;
+import org.apache.lucene.index.DirectoryReader;
+import org.apache.lucene.index.IndexWriter;
+import org.apache.lucene.index.IndexWriterConfig;
+import org.apache.lucene.index.Term;
+import org.apache.lucene.search.similarities.AxiomaticF2EXP;
+import org.apache.lucene.search.similarities.AxiomaticF2LOG;
+import org.apache.lucene.search.similarities.BM25Similarity;
+import org.apache.lucene.search.similarities.Similarity;
+import org.apache.lucene.store.Directory;
+import org.apache.lucene.tests.analysis.MockAnalyzer;
+import org.apache.lucene.tests.search.CheckHits;
+import org.apache.lucene.tests.util.LuceneTestCase;
+import org.apache.lucene.tests.util.TestUtil;
+
+/**
+ * CombinedFieldQuery's max score must be a finite upper bound of its scores, otherwise top-k
+ * pruning skips competitive hits. AxiomaticF2LOG and AxiomaticF2EXP keep the default computeNorm,
+ * so the CombinedFieldQuery javadoc counts them as compatible.
+ *
+ * <p>Index: 3000 documents in one segment. Docs 0 and 2000 match only the CombinedFieldQuery on
+ * fields a and b (doc 2000 scores best); every other document matches only the TermQuery c:y.
+ */
+public class TestCombinedFieldQueryMaxScore extends LuceneTestCase {
+
+  private static final int NUM_DOCS = 3000;
+  private static final int BEST_DOC = 2000;
+
+  private static void indexDocs(Directory dir, Similarity sim) throws IOException {
+    IndexWriterConfig iwc =
+        new IndexWriterConfig(new MockAnalyzer(random()))
+            .setSimilarity(sim)
+            .setCodec(TestUtil.getDefaultCodec())
+            .setMergePolicy(newLogMergePolicy());
+    try (IndexWriter w = new IndexWriter(dir, iwc)) {
+      for (int i = 0; i < NUM_DOCS; i++) {
+        Document doc = new Document();
+        if (i == 0) {
+          // matches only the CombinedFieldQuery: one occurrence in long fields
+          doc.add(new TextField("a", "x f f f f f f f f f f f f f f f f f f f", Field.Store.NO));
+          doc.add(new TextField("b", "f f f f f", Field.Store.NO));
+        } else if (i == BEST_DOC) {
+          // matches only the CombinedFieldQuery: four occurrences in short fields
+          doc.add(new TextField("a", "x x x", Field.Store.NO));
+          doc.add(new TextField("b", "x", Field.Store.NO));
+        } else {
+          // matches only the TermQuery c:y
+          doc.add(new TextField("a", "f f", Field.Store.NO));
+          doc.add(new TextField("b", "f", Field.Store.NO));
+          doc.add(new TextField("c", "y", Field.Store.NO));
+        }
+        w.addDocument(doc);
+      }
+      w.forceMerge(1);
+    }
+  }
+
+  private static IndexSearcher plainSearcher(DirectoryReader reader, Similarity sim) {
+    IndexSearcher searcher = new IndexSearcher(reader);
+    searcher.setSimilarity(sim);
+    searcher.setQueryCache(null);
+    return searcher;
+  }
+
+  private static Query combinedField() {
+    return new CombinedFieldQuery.Builder("x").addField("a").addField("b").build();
+  }
+
+  /** SHOULD CombinedFieldQuery(x on a, b) + SHOULD TermQuery(c:y). */
+  private static Query combinedFieldOrTerm() {
+    return new BooleanQuery.Builder()
+        .add(combinedField(), BooleanClause.Occur.SHOULD)
+        .add(new TermQuery(new Term("c", "y")), BooleanClause.Occur.SHOULD)
+        .build();
+  }
+
+  private static void assertMaxScoreIsUpperBound(Similarity sim) throws IOException {
+    try (Directory dir = newDirectory()) {
+      indexDocs(dir, sim);
+      try (DirectoryReader reader = DirectoryReader.open(dir)) {
+        assertEquals(1, reader.leaves().size());
+        IndexSearcher searcher = plainSearcher(reader, sim);
+        Weight weight =
+            searcher.createWeight(searcher.rewrite(combinedField()), ScoreMode.TOP_SCORES, 1f);
+        Scorer scorer = weight.scorer(reader.leaves().get(0));
+        assertNotNull(scorer);
+        float maxScore = scorer.getMaxScore(DocIdSetIterator.NO_MORE_DOCS);
+        DocIdSetIterator it = scorer.iterator();
+        for (int doc = it.nextDoc(); doc != DocIdSetIterator.NO_MORE_DOCS; doc = it.nextDoc()) {
+          float score = scorer.score();
+          assertTrue(
+              sim + ": doc " + doc + " scores " + score + " but getMaxScore returned " + maxScore,
+              score <= maxScore);
+        }
+      }
+    }
+  }
+
+  private static void assertDefaultSearchFindsBestDoc(Similarity sim) throws IOException {
+    try (Directory dir = newDirectory()) {
+      indexDocs(dir, sim);
+      try (DirectoryReader reader = DirectoryReader.open(dir)) {
+        IndexSearcher searcher = plainSearcher(reader, sim);
+        // the plain API: dynamic pruning starts once 1000 hits have been counted
+        TopDocs top10 = searcher.search(combinedFieldOrTerm(), 10);
+        ScoreDoc top = top10.scoreDocs[0];
+        assertEquals(
+            sim
+                + ": IndexSearcher#search(q, 10) top hit is doc "
+                + top.doc
+                + " ("
+                + top.score
+                + ")",
+            BEST_DOC,
+            top.doc);
+      }
+    }
+  }
+
+  public void testMaxScoreIsUpperBoundF2LOG() throws IOException {
+    assertMaxScoreIsUpperBound(new AxiomaticF2LOG());
+  }
+
+  public void testMaxScoreIsUpperBoundF2EXP() throws IOException {
+    assertMaxScoreIsUpperBound(new AxiomaticF2EXP());
+  }
+
+  public void testDefaultSearchFindsBestDocF2LOG() throws IOException {
+    assertDefaultSearchFindsBestDoc(new AxiomaticF2LOG());
+  }
+
+  public void testDefaultSearchFindsBestDocF2EXP() throws IOException {
+    assertDefaultSearchFindsBestDoc(new AxiomaticF2EXP());
+  }
+
+  /** Lucene's own oracle: TOP_SCORES and COMPLETE collection must return the same top hits. */
+  public void testCheckTopScoresF2LOG() throws IOException {
+    Similarity sim = new AxiomaticF2LOG();
+    try (Directory dir = newDirectory()) {
+      indexDocs(dir, sim);
+      try (DirectoryReader reader = DirectoryReader.open(dir)) {
+        CheckHits.checkTopScores(random(), combinedFieldOrTerm(), plainSearcher(reader, sim));
+      }
+    }
+  }
+
+  /** Control: the default BM25 similarity gives a finite bound and the right top hit. */
+  public void testBM25Control() throws IOException {
+    assertMaxScoreIsUpperBound(new BM25Similarity());
+    assertDefaultSearchFindsBestDoc(new BM25Similarity());
+  }
+}
