+  /**
+   * The merge-reuse repair must reconnect the reused graph's entry node when that node lost every
+   * neighbour. Points on a line: ord 171 at 0, ords 0, 4 and 215 at 1, 2 and 3, every other ord i
+   * at 100 + i. With seed 42, ord 171 is the first node of the top level (level 2), and its only
+   * links on levels 0, 1 and 2 go to ords 0, 4 and 215. Deleting those 3 ords (0.2%) leaves ord 171
+   * as the entry of the reused graph with no neighbours left.
+   */
+  public void testRepairReconnectsEntryNodeThatLostAllNeighbors() throws IOException {
+    long savedRandSeed = HnswGraphBuilder.randSeed;
+    try {
+      HnswGraphBuilder.randSeed = 42;
+      similarityFunction = VectorSimilarityFunction.EUCLIDEAN;
+      int n = 1450;
+      float[][] all = new float[n][];
+      for (int i = 0; i < n; i++) {
+        float pos = i == 171 ? 0 : i == 0 ? 1 : i == 4 ? 2 : i == 215 ? 3 : 100 + i;
+        all[i] = new float[] {pos, 0};
+      }
+      RandomVectorScorerSupplier allScorer = buildScorerSupplier(MockVectorValues.fromValues(all));
+      OnHeapHnswGraph source = HnswGraphBuilder.create(allScorer, 16, 100, 42).build(n);
+      int[] newOrdMap = new int[n];
+      float[][] live = new float[n - 3][];
+      for (int old = 0, next = 0; old < n; old++) {
+        boolean deleted = old == 0 || old == 4 || old == 215;
+        newOrdMap[old] = deleted ? -1 : next;
+        if (deleted == false) {
+          live[next++] = all[old];
+        }
+      }
+      MockVectorValues liveVectors = MockVectorValues.fromValues(live);
+      OnHeapHnswGraph merged =
+          InitializedHnswGraphBuilder.initGraph(
+              source, newOrdMap, live.length, 100, buildScorerSupplier(liveVectors));
+
+      int entry = merged.entryNode();
+      assertEquals("old ord 171 (new ord 169) is the entry of the merged graph", 169, entry);
+      int[] degrees = new int[merged.numLevels()];
+      for (int level = 0; level < degrees.length; level++) {
+        degrees[level] = merged.getNeighbors(level, entry).size();
+      }
+      KnnCollector top5 =
+          HnswGraphSearcher.search(
+              buildScorer(liveVectors, new float[] {1000.3f, 0}),
+              5,
+              merged,
+              null,
+              Integer.MAX_VALUE);
+      int hits = top5.topDocs().scoreDocs.length;
+      assertTrue(
+          "entry node degree per level after repair = "
+              + Arrays.toString(degrees)
+              + ", a 5-NN search returned "
+              + hits
+              + " hit(s)",
+          degrees[0] > 0 && hits == 5);
+    } finally {
+      HnswGraphBuilder.randSeed = savedRandSeed;
+    }
+  }
