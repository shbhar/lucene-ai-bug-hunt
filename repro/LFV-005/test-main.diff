+  /**
+   * End to end with the default codec: a plain forceMerge(1) must keep kNN recall. 1450 docs, 16
+   * dims: doc 171 at -10 on axis 0, cluster A (docs 0..29 and 215) at 0, the other 1418 docs at
+   * +10. The flushed graph's first top-level node is doc 171 (seed 42), and it links only to
+   * cluster A. Deleting cluster A (2.1% of the docs) makes the merge reuse the graph with doc 171
+   * as its entry.
+   */
+  public void testForceMergeKeepsRecallWhenReusedEntryLosesAllNeighbors() throws IOException {
+    long savedRandSeed = HnswGraphBuilder.randSeed;
+    try (Directory dir = newDirectory()) {
+      HnswGraphBuilder.randSeed = 42;
+      int n = 1450, dim = 16;
+      Random random = new Random(20261022L);
+      float[][] vectors = new float[n][dim];
+      boolean[] inA = new boolean[n];
+      for (int i = 0; i < n; i++) {
+        inA[i] = i < 30 || i == 215;
+        for (int d = 0; d < dim; d++) {
+          vectors[i][d] = (float) (random.nextGaussian() * 0.3);
+        }
+        vectors[i][0] += i == 171 ? -10 : inA[i] ? 0 : 10;
+      }
+      random = new Random(7L);
+      float[][] queries = new float[50][dim]; // all in the big cluster at +10
+      for (float[] q : queries) {
+        for (int d = 0; d < dim; d++) {
+          q[d] = (float) (random.nextGaussian() * 0.3);
+        }
+        q[0] += 10;
+      }
+      double before, after;
+      IndexWriterConfig iwc = new IndexWriterConfig().setCodec(TestUtil.getDefaultCodec());
+      try (IndexWriter w = new IndexWriter(dir, iwc)) {
+        for (int i = 0; i < n; i++) {
+          Document doc = new Document();
+          doc.add(new StoredField(ID_FIELD, i));
+          doc.add(new StringField("cluster", inA[i] ? "A" : "B", Field.Store.NO));
+          doc.add(new KnnFloatVectorField("vec", vectors[i], VectorSimilarityFunction.EUCLIDEAN));
+          w.addDocument(doc);
+        }
+        w.commit(); // one segment of 1450 docs
+        w.deleteDocuments(new Term("cluster", "A"));
+        w.commit();
+        before = recallAt10(w, vectors, inA, queries);
+        w.forceMerge(1);
+        after = recallAt10(w, vectors, inA, queries);
+      }
+      TestUtil.checkIndex(dir); // passes
+      assertTrue("recall@10 before the merge = " + before, before > 0.85);
+      assertTrue("recall@10 after forceMerge(1) = " + after + ", before = " + before, after > 0.85);
+    } finally {
+      HnswGraphBuilder.randSeed = savedRandSeed;
+    }
+  }
+
+  private static double recallAt10(
+      IndexWriter w, float[][] vectors, boolean[] deleted, float[][] queries) throws IOException {
+    try (DirectoryReader reader = DirectoryReader.open(w)) {
+      IndexSearcher searcher = new IndexSearcher(reader);
+      int found = 0;
+      for (float[] q : queries) {
+        List<Integer> exact = new ArrayList<>();
+        for (int i = 0; i < vectors.length; i++) {
+          if (deleted[i] == false) {
+            exact.add(i);
+          }
+        }
+        exact.sort(
+            (a, b) ->
+                Float.compare(
+                    VectorUtil.squareDistance(q, vectors[a]),
+                    VectorUtil.squareDistance(q, vectors[b])));
+        exact = exact.subList(0, 10);
+        for (ScoreDoc sd : searcher.search(new KnnFloatVectorQuery("vec", q, 10), 10).scoreDocs) {
+          Document doc = searcher.storedFields().document(sd.doc);
+          if (exact.contains(doc.getField(ID_FIELD).numericValue().intValue())) {
+            found++;
+          }
+        }
+      }
+      return found / (10.0 * queries.length);
+    }
+  }
