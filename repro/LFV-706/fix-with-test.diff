+  public void testExactMatchFirstFalse() throws Exception {
+    Directory tempDir = getDirectory();
+    FSTCompletionLookup lookup = new FSTCompletionLookup(tempDir, "fst", 10, false);
+    lookup.build(
+        new InputArrayIterator(new Input[] {tf("star", 1), tf("star wars", 100), tf("start", 50)}));
+    // The exact match keeps its place in weight order.
+    String expected = "[star wars/6, start/3, star/0]";
+    assertEquals(expected, lookup.lookup(stringToCharSequence("star"), true, 3).toString());
+
+    ByteBuffersDataOutput out = new ByteBuffersDataOutput();
+    assertTrue(lookup.store(out));
+    FSTCompletionLookup loaded = new FSTCompletionLookup(tempDir, "fst", 10, false);
+    assertTrue(loaded.load(out.toDataInput()));
+    assertEquals(expected, loaded.lookup(stringToCharSequence("star"), true, 3).toString());
+    tempDir.close();
+  }
