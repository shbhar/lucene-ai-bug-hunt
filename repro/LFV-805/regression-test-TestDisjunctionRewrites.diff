+  public void testDisjunctionWithRepeatedSource() {
+    // On distinct positions ordered(a, a) and unordered(a, a) span 2+ positions, so the rewrite
+    // must split them out: BLOCK(x, or(REPEAT, a), c) => or(BLOCK(x, REPEAT, c), BLOCK(x, a, c))
+    for (IntervalsSource repeat :
+        new IntervalsSource[] {
+          ordered(term("a"), term("a")), Intervals.unordered(term("a"), term("a"))
+        }) {
+      IntervalsSource actual = phrase(term("x"), or(repeat, term("a")), term("c"));
+      IntervalsSource expected =
+          or(phrase(term("x"), repeat, term("c")), phrase(term("x"), term("a"), term("c")));
+      assertEquals(expected, actual);
+    }
+  }
