+  public void testRangesAcrossLengthsRejectOverlongEncodings() {
+    // The shortest 3-byte sequence is E0 A0 80 (U+0800) and the shortest 4-byte one is F0 90 80 80
+    // (U+10000), so E0 80..9F xx and F0 80..8F xx xx encode no code point.
+    byte[][] overlong = {
+      {(byte) 0xE0, (byte) 0x80, (byte) 0x80},
+      {(byte) 0xE0, (byte) 0x9F, (byte) 0xBF},
+      {(byte) 0xF0, (byte) 0x80, (byte) 0x80, (byte) 0x80},
+      {(byte) 0xF0, (byte) 0x8F, (byte) 0xBF, (byte) 0xBF}
+    };
+    int[][] ranges = {
+      {0, 0x1000},
+      {0x7F, 0x1000},
+      {0x7FF, 0x1000},
+      {0, 0x10000},
+      {0x800, 0x40000},
+      {0xFFFF, 0x40000},
+      {0, MAX_UNICODE}
+    };
+    for (int[] range : ranges) {
+      ByteRunAutomaton a = new ByteRunAutomaton(Automata.makeCharRange(range[0], range[1]));
+      assertTrue(matches(a, range[0]));
+      assertTrue(matches(a, range[1]));
+      for (byte[] b : overlong) {
+        assertFalse(
+            "range "
+                + Integer.toHexString(range[0])
+                + "-"
+                + Integer.toHexString(range[1])
+                + " accepted overlong "
+                + new BytesRef(b),
+            a.run(b, 0, b.length));
+      }
+    }
+  }
+
+  public void testRangeAcrossLengthsHasOneStringPerCodePoint() {
+    Automaton utf8 = new UTF32ToUTF8().convert(Automata.makeCharRange(0x7F, 0x1000));
+    assertEquals(0x1000 - 0x7F + 1, TestOperations.getFiniteStrings(utf8).size());
+  }
+
