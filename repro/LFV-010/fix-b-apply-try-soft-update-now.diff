+  @Override
+  void onTryDocValuesUpdate(DocValuesFieldUpdates update) throws IOException {
+    if (this.field.equals(update.field)) {
+      // Apply it to the live docs now, as a delete by document ID is. When the pending updates are
+      // written, onDocValuesUpdate applies the newest value of each document again.
+      pendingDeleteCount += applySoftDeletes(update.iterator(), getMutableBits());
+      assert assertPendingDeletes();
+    }
+  }
+
   private boolean assertPendingDeletes() {
     assert pendingDeleteCount + info.getSoftDelCount() >= 0
         : "illegal pending delete count: " + (pendingDeleteCount + info.getSoftDelCount());
