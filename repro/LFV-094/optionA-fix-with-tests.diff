+package org.apache.lucene.document.column;
+
+import java.io.IOException;
+import java.util.List;
+import org.apache.lucene.document.Document;
+import org.apache.lucene.document.Field;
+import org.apache.lucene.document.FieldType;
+import org.apache.lucene.document.SortedDocValuesField;
+import org.apache.lucene.document.SortedSetDocValuesField;
+import org.apache.lucene.document.StringField;
+import org.apache.lucene.index.DirectoryReader;
+import org.apache.lucene.index.IndexWriter;
+import org.apache.lucene.index.IndexWriterConfig;
+import org.apache.lucene.index.LeafReader;
+import org.apache.lucene.index.NoMergePolicy;
+import org.apache.lucene.index.SortedSetDocValues;
+import org.apache.lucene.search.DocIdSetIterator;
+import org.apache.lucene.store.Directory;
+import org.apache.lucene.tests.util.LuceneTestCase;
+import org.apache.lucene.tests.util.TestUtil;
+import org.apache.lucene.util.BytesRef;
+
+/**
+ * IndexWriter#addBatch rejects a SORTED_SET DictionaryColumn whose first tuple for a document has
+ * an out-of-range ordinal (or whose ordValue() throws there) with a non-aborting exception, and the
+ * writer stays open. A rejected batch should leave no trace: documents added before and after it
+ * must still commit and read back.
+ */
+public class TestSortedSetDictionaryColumnRejection extends LuceneTestCase {
+
+  private static final List<BytesRef> DICT = List.of(new BytesRef("x"), new BytesRef("y"));
+
+  /**
+   * A one-document batch: tuples (0, ords[0]), (0, ords[1]), ...; ordValue() throws {@code toThrow}
+   * instead of returning ords[throwAt].
+   */
+  private static ColumnBatch oneDocBatch(
+      FieldType type, int[] ords, int throwAt, RuntimeException toThrow) {
+    DictionaryColumn column =
+        new DictionaryColumn("tags", type, Column.Density.SPARSE, DICT) {
+          @Override
+          public OrdinalsTupleCursor tuples() {
+            return new OrdinalsTupleCursor() {
+              int pos = -1;
+
+              @Override
+              public int nextDoc() {
+                pos++;
+                return pos < ords.length ? 0 : DocIdSetIterator.NO_MORE_DOCS;
+              }
+
+              @Override
+              public int ordValue() {
+                if (pos == throwAt) {
+                  throw toThrow;
+                }
+                return ords[pos];
+              }
+            };
+          }
+        };
+    return new ColumnBatch() {
+      @Override
+      public int numDocs() {
+        return 1;
+      }
+
+      @Override
+      public Iterable<Column> columns() {
+        return List.of(column);
+      }
+    };
+  }
+
+  private static IndexWriterConfig config() {
+    return new IndexWriterConfig().setCodec(TestUtil.getDefaultCodec());
+  }
+
+  private static Document tagsDoc(String... values) {
+    Document doc = new Document();
+    for (String value : values) {
+      doc.add(new SortedSetDocValuesField("tags", new BytesRef(value)));
+    }
+    return doc;
+  }
+
+  private static void assertTags(SortedSetDocValues dv, int doc, String... expected)
+      throws IOException {
+    assertTrue("doc " + doc + " has no tags", dv.advanceExact(doc));
+    assertEquals(expected.length, dv.docValueCount());
+    for (String value : expected) {
+      assertEquals(new BytesRef(value), dv.lookupOrd(dv.nextOrd()));
+    }
+  }
+
+  /**
+   * TestColumnBatchDictionaryColumn#testOutOfRangeOrdSparseThrows uses SORTED; the same test with
+   * SORTED_SET: expect the IllegalArgumentException, then close the writer.
+   */
+  public void testOutOfRangeOrdSparseSortedSetThenClose() throws IOException {
+    try (Directory dir = newDirectory()) {
+      IndexWriter w = new IndexWriter(dir, config());
+      ColumnBatch bad = oneDocBatch(SortedSetDocValuesField.TYPE, new int[] {5}, -1, null);
+      expectThrows(IllegalArgumentException.class, () -> w.addBatch(bad));
+      w.close(); // commits on close
+    }
+  }
+
+  /**
+   * One committed document, five buffered ones, a rejected batch, then a valid document with two
+   * values. The commit must keep all 7 documents.
+   */
+  public void testRejectedOrdinalKeepsBufferedDocuments() throws IOException {
+    try (Directory dir = newDirectory()) {
+      IndexWriter w = new IndexWriter(dir, config());
+      Document committed = new Document();
+      committed.add(new StringField("id", "committed", Field.Store.NO));
+      w.addDocument(committed);
+      w.commit();
+      for (int i = 0; i < 5; i++) {
+        Document buffered = new Document();
+        buffered.add(new StringField("id", "buffered" + i, Field.Store.NO));
+        w.addDocument(buffered);
+      }
+
+      ColumnBatch bad = oneDocBatch(SortedSetDocValuesField.TYPE, new int[] {5}, -1, null);
+      IllegalArgumentException e =
+          expectThrows(IllegalArgumentException.class, () -> w.addBatch(bad));
+      assertTrue(e.getMessage(), e.getMessage().contains("out of range"));
+      assertTrue(w.isOpen());
+      assertNull(w.getTragicException());
+
+      w.addDocument(tagsDoc("p", "q"));
+      Throwable commitFailure = null;
+      try {
+        w.commit();
+      } catch (Throwable t) {
+        commitFailure = t;
+      }
+      boolean openAfterCommit = w.isOpen();
+      if (openAfterCommit) {
+        w.close();
+      }
+      try (DirectoryReader reader = DirectoryReader.open(dir)) {
+        if (commitFailure != null) {
+          AssertionError error =
+              new AssertionError(
+                  "commit after the rejected batch failed: "
+                      + commitFailure
+                      + "; writer open: "
+                      + openAfterCommit
+                      + "; documents in the index: "
+                      + reader.numDocs()
+                      + " of 7");
+          error.initCause(commitFailure);
+          throw error;
+        }
+        assertEquals(7, reader.numDocs());
+      }
+    }
+  }
+
+  /**
+   * A document with one value, the rejected batch, a document with two values. The committed
+   * segment's field must open, list both live documents, and pass CheckIndex.
+   */
+  public void testRejectedOrdinalLeavesReadableField() throws IOException {
+    try (Directory dir = newDirectory()) {
+      try (IndexWriter w = new IndexWriter(dir, config().setMergePolicy(NoMergePolicy.INSTANCE))) {
+        w.addDocument(tagsDoc("a"));
+        ColumnBatch bad = oneDocBatch(SortedSetDocValuesField.TYPE, new int[] {5}, -1, null);
+        expectThrows(IllegalArgumentException.class, () -> w.addBatch(bad));
+        w.addDocument(tagsDoc("v0", "v1"));
+        w.commit();
+      }
+      try (DirectoryReader reader = DirectoryReader.open(dir)) {
+        assertEquals(2, reader.numDocs());
+        LeafReader leaf = getOnlyLeafReader(reader);
+        SortedSetDocValues dv = leaf.getSortedSetDocValues("tags");
+        assertTags(dv, 0, "a");
+        assertTags(dv, 2, "v0", "v1");
+      }
+      TestUtil.checkIndex(dir);
+    }
+  }
+
+  /**
+   * No invalid input: the application's cursor throws from ordValue() on the document's first tuple
+   * (for example a decode error), with every ordinal in range.
+   */
+  public void testThrowingOrdValueOnFirstTuple() throws IOException {
+    try (Directory dir = newDirectory()) {
+      try (IndexWriter w = new IndexWriter(dir, config())) {
+        IllegalStateException decodeError = new IllegalStateException("decode error");
+        ColumnBatch throwing =
+            oneDocBatch(SortedSetDocValuesField.TYPE, new int[] {0}, 0, decodeError);
+        assertSame(
+            decodeError, expectThrows(IllegalStateException.class, () -> w.addBatch(throwing)));
+        assertTrue(w.isOpen());
+        w.addDocument(tagsDoc("p", "q"));
+        w.commit();
+      }
+      try (DirectoryReader reader = DirectoryReader.open(dir)) {
+        assertEquals(1, reader.numDocs());
+        LeafReader leaf = getOnlyLeafReader(reader);
+        assertTags(leaf.getSortedSetDocValues("tags"), leaf.maxDoc() - 1, "p", "q");
+      }
+    }
+  }
+
+  /** Control: the upstream test as written (SORTED). Passes on stock Lucene. */
+  public void testOutOfRangeOrdSparseSortedThenCloseControl() throws IOException {
+    try (Directory dir = newDirectory()) {
+      IndexWriter w = new IndexWriter(dir, config());
+      ColumnBatch bad = oneDocBatch(SortedDocValuesField.TYPE, new int[] {5}, -1, null);
+      expectThrows(IllegalArgumentException.class, () -> w.addBatch(bad));
+      w.close();
+    }
+  }
+
+  /**
+   * Control: the bad ordinal is the SECOND tuple of the document (the first is valid). Passes on
+   * stock Lucene: only a rejected first tuple leaves an empty document behind.
+   */
+  public void testRejectedSecondTupleControl() throws IOException {
+    try (Directory dir = newDirectory()) {
+      try (IndexWriter w = new IndexWriter(dir, config())) {
+        ColumnBatch bad = oneDocBatch(SortedSetDocValuesField.TYPE, new int[] {0, 5}, -1, null);
+        expectThrows(IllegalArgumentException.class, () -> w.addBatch(bad));
+        w.addDocument(tagsDoc("p", "q"));
+        w.commit();
+      }
+      try (DirectoryReader reader = DirectoryReader.open(dir)) {
+        assertEquals(1, reader.numDocs());
+      }
+      TestUtil.checkIndex(dir);
+    }
+  }
+}
