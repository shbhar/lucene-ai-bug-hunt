+  // A start tag whose name only begins with "script", "style" or "br" (an XML-like name such as
+  // scripts or stylesheet, a custom element such as style-guide) is an ordinary element: only the
+  // tags are removed, as for any other unknown element name.
+
+  public void testElementNameStartingWithScript() throws Exception {
+    // control: same shape, a name that does not begin with "script"
+    assertHTMLStripsTo("<scrapes>hello</scrapes> world", "\nhello\n world", null);
+    assertHTMLStripsTo("<scripts>hello</scripts> world", "\nhello\n world", null);
+    // a later real script element is still removed up to its own end tag
+    assertHTMLStripsTo(
+        "<scripting>alpha</scripting> beta <script>f()</script> gamma",
+        "\nalpha\n beta \n gamma",
+        null);
+  }
+
+  public void testElementNameStartingWithStyle() throws Exception {
+    // control: same shape, a name that does not begin with "style"
+    assertHTMLStripsTo("<stale-guide>hello</stale-guide> world", "\nhello\n world", null);
+    assertHTMLStripsTo("<style-guide>hello</style-guide> world", "\nhello\n world", null);
+    assertHTMLStripsTo("<stylesheet>hello</stylesheet> world", "\nhello\n world", null);
+  }
+
+  public void testElementNameStartingWithStyleIndexesText() throws Exception {
+    Analyzer a = newTestAnalyzer();
+    assertAnalyzesTo(
+        a,
+        "<stylesheet>hello</stylesheet> world",
+        new String[] {"hello", "world"},
+        new int[] {12, 31},
+        new int[] {17, 36});
+    a.close();
+  }
+
+  public void testEscapedElementNameStartingWithBrOrScript() throws Exception {
+    // control: same shape, a name that does not begin with "br"
+    assertHTMLStripsTo(
+        "<bland>Acme</bland>", "<bland>Acme</bland>", new HashSet<>(Arrays.asList("bland")));
+    // "Tags in this set (both start and end tags) will not be filtered out."
+    assertHTMLStripsTo(
+        "<brand>Acme</brand>", "<brand>Acme</brand>", new HashSet<>(Arrays.asList("brand")));
+    // escaping br or script does not escape a longer name
+    assertHTMLStripsTo(
+        "x<bridge>alpha</bridge>y", "x\nalpha\ny", new HashSet<>(Arrays.asList("br")));
+    assertHTMLStripsTo(
+        "x<scripted>alpha</scripted>y", "x\nalpha\ny", new HashSet<>(Arrays.asList("script")));
+  }
+
+  public void testScriptStyleAndBrTagsStillMatch() throws Exception {
+    // real script, style and br tags, with and without attributes
+    assertHTMLStripsTo("a<script>f();</script>b", "a\nb", null);
+    assertHTMLStripsTo("a<script type=\"t\">f();</script>b", "a\nb", null);
+    assertHTMLStripsTo("a<style>p{}</style>b", "a\nb", null);
+    assertHTMLStripsTo("one<br>two<br/>three<br class=\"x\">four", "one\ntwo\nthree\nfour", null);
+    // behaviour a fix must keep: '/' after the name starts a script element (since 10.5.0),
+    // and a quoted attribute value of a br tag may contain '>'
+    assertHTMLStripsTo("a<script/>f();</script>b", "a\nb", null);
+    assertHTMLStripsTo("one<br title=\"a>b\">two", "one\ntwo", null);
+  }
+
