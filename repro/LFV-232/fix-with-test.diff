+package org.apache.lucene.search.grouping;
+
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import org.apache.lucene.document.Document;
+import org.apache.lucene.document.NumericDocValuesField;
+import org.apache.lucene.document.SortedDocValuesField;
+import org.apache.lucene.index.DirectoryReader;
+import org.apache.lucene.index.IndexWriter;
+import org.apache.lucene.index.IndexWriterConfig;
+import org.apache.lucene.index.NoMergePolicy;
+import org.apache.lucene.queries.function.FunctionScoreQuery;
+import org.apache.lucene.search.DoubleValuesSource;
+import org.apache.lucene.search.IndexSearcher;
+import org.apache.lucene.search.MatchAllDocsQuery;
+import org.apache.lucene.search.Query;
+import org.apache.lucene.search.Sort;
+import org.apache.lucene.search.SortField;
+import org.apache.lucene.store.Directory;
+import org.apache.lucene.tests.util.LuceneTestCase;
+import org.apache.lucene.util.BytesRef;
+import org.apache.lucene.util.NamedThreadFactory;
+
+/**
+ * A within-group sort that is equal to Sort.RELEVANCE but not the same instance, for example {@code
+ * new Sort(SortField.FIELD_SCORE)} or {@code new Sort()}, makes TopGroupsCollector take its
+ * field-sort path (it tests {@code withinGroupSort == Sort.RELEVANCE}), which returns FieldDocs
+ * with NaN scores, while TopGroups.merge (it tests {@code docSort.equals(Sort.RELEVANCE)}) merges
+ * them as score-sorted hits by those NaN scores. With an executor the documents of a group then
+ * come back out of score order, and GroupDocs.maxScore is NaN even with setIncludeMaxScore(true).
+ *
+ * <p>Index: 6 segments, all documents in group "g", score = the "score" doc-values field. Segment
+ * 0: doc 0 (score 4). Segment 1: doc 1 (score 5), doc 2 (score 1). Segments 2..5: two documents
+ * with score 1 each. With the default slicing, segments 1..5 form slice 0 and segment 0 forms slice
+ * 1. The two best documents are doc 1 (5) and doc 0 (4).
+ */
+public class TestEqualRelevanceSortWithinGroup extends LuceneTestCase {
+
+  private Directory dir;
+  private DirectoryReader reader;
+  private ExecutorService executor;
+  private Query query;
+
+  @Override
+  public void setUp() throws Exception {
+    super.setUp();
+    dir = newDirectory();
+    IndexWriterConfig iwc = new IndexWriterConfig().setMergePolicy(NoMergePolicy.INSTANCE);
+    int[][] segments = {{4}, {5, 1}, {1, 1}, {1, 1}, {1, 1}, {1, 1}};
+    try (IndexWriter w = new IndexWriter(dir, iwc)) {
+      for (int[] scores : segments) {
+        for (int score : scores) {
+          Document d = new Document();
+          d.add(new SortedDocValuesField("group", new BytesRef("g")));
+          d.add(new NumericDocValuesField("score", score));
+          w.addDocument(d);
+        }
+        w.flush();
+      }
+    }
+    reader = DirectoryReader.open(dir);
+    assertEquals(6, reader.leaves().size());
+    executor = Executors.newFixedThreadPool(2, new NamedThreadFactory("TestEqualRelevanceSort"));
+    query =
+        new FunctionScoreQuery(new MatchAllDocsQuery(), DoubleValuesSource.fromIntField("score"));
+  }
+
+  @Override
+  public void tearDown() throws Exception {
+    executor.shutdown();
+    assertTrue(executor.awaitTermination(30, TimeUnit.SECONDS));
+    reader.close();
+    dir.close();
+    super.tearDown();
+  }
+
+  private GroupDocs<?> topGroup(IndexSearcher searcher, Sort withinGroupSort) throws Exception {
+    GroupingSearch gs = new GroupingSearch("group");
+    gs.setSortWithinGroup(withinGroupSort).setGroupDocsLimit(2).setIncludeMaxScore(true);
+    TopGroups<?> tg = gs.search(searcher, query, 0, 10);
+    assertEquals(1, tg.groups.length);
+    return tg.groups[0];
+  }
+
+  private static int[] docs(GroupDocs<?> gd) {
+    return Arrays.stream(gd.scoreDocs()).mapToInt(sd -> sd.doc).toArray();
+  }
+
+  public void testSortsAreEqual() {
+    assertEquals(Sort.RELEVANCE, new Sort(SortField.FIELD_SCORE));
+    assertEquals(Sort.RELEVANCE, new Sort());
+  }
+
+  /** Control: the Sort.RELEVANCE instance itself gives the right page with and without executor. */
+  public void testRelevanceInstanceControl() throws Exception {
+    assertArrayEquals(new int[] {1, 0}, docs(topGroup(new IndexSearcher(reader), Sort.RELEVANCE)));
+    assertArrayEquals(
+        new int[] {1, 0}, docs(topGroup(new IndexSearcher(reader, executor), Sort.RELEVANCE)));
+  }
+
+  /** Concurrent search returns doc 2 (score 1) instead of doc 0 (score 4). */
+  public void testDocOrderWithEqualSortAndExecutor() throws Exception {
+    IndexSearcher concurrent = new IndexSearcher(reader, executor);
+    assertEquals(2, concurrent.getSlices().length);
+    GroupDocs<?> gd = topGroup(concurrent, new Sort(SortField.FIELD_SCORE));
+    assertArrayEquals("top 2 documents by score", new int[] {1, 0}, docs(gd));
+  }
+
+  /** Same through the public collector managers (also present in 10.5.x). */
+  public void testDocOrderWithEqualSortThroughManagers() throws Exception {
+    IndexSearcher concurrent = new IndexSearcher(reader, executor);
+    Sort withinGroupSort = new Sort(SortField.FIELD_SCORE);
+    Collection<SearchGroup<BytesRef>> groups =
+        concurrent.search(
+            query,
+            new FirstPassGroupingCollectorManager<>(
+                () -> new TermGroupSelector("group"), Sort.RELEVANCE, 0, 10));
+    TopGroups<BytesRef> tg =
+        concurrent.search(
+            query,
+            new TopGroupsCollectorManager<>(
+                () -> new TermGroupSelector("group"),
+                groups,
+                Sort.RELEVANCE,
+                withinGroupSort,
+                0,
+                2,
+                true));
+    assertArrayEquals("top 2 documents by score", new int[] {1, 0}, docs(tg.groups[0]));
+    assertEquals("maxScore (getMaxScores=true)", 5f, tg.groups[0].maxScore(), 0f);
+  }
+
+  /** Sequential search: the page is right, but maxScore is NaN although includeMaxScore is set. */
+  public void testMaxScoreWithEqualSortSequential() throws Exception {
+    GroupDocs<?> gd = topGroup(new IndexSearcher(reader), new Sort(SortField.FIELD_SCORE));
+    assertArrayEquals(new int[] {1, 0}, docs(gd));
+    assertEquals("GroupDocs.maxScore with setIncludeMaxScore(true)", 5f, gd.maxScore(), 0f);
+  }
+}
