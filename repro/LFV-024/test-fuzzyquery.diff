+  public void testEmptyTerm() throws Exception {
+    Directory directory = newDirectory();
+    RandomIndexWriter writer = new RandomIndexWriter(random(), directory);
+    for (String text : new String[] {"", "a", "b", "ab", "abc"}) {
+      Document doc = new Document();
+      doc.add(new StringField("field", text, Field.Store.NO));
+      writer.addDocument(doc);
+    }
+    IndexReader reader = writer.getReader();
+    IndexSearcher searcher = newSearcher(reader);
+    writer.close();
+
+    // the edit distance from "" to a term is the term's length
+    Term empty = new Term("field", "");
+    assertEquals(1, searcher.count(new FuzzyQuery(empty, 0)));
+    assertEquals(3, searcher.count(new FuzzyQuery(empty, 1)));
+    assertEquals(4, searcher.count(new FuzzyQuery(empty, 2)));
+    assertEquals(
+        4,
+        searcher.count(
+            new FuzzyQuery(empty, 2, 0, 50, true, MultiTermQuery.CONSTANT_SCORE_REWRITE)));
+
+    reader.close();
+    directory.close();
+  }
+
