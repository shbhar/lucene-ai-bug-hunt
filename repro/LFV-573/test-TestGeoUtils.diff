+  // a sort key matches distanceQuerySortKey(radius) exactly when its distance is <= radius
+  public void testDistanceQuerySortKeyAtTheRadius() {
+    int iters = atLeast(1000);
+    for (int i = 0; i < iters; i++) {
+      double lat = GeoTestUtil.nextLatitude();
+      double lon = GeoTestUtil.nextLongitude();
+      double lat2 = GeoTestUtil.nextLatitude();
+      double lon2 = GeoTestUtil.nextLongitude();
+      double sortKey = SloppyMath.haversinSortKey(lat, lon, lat2, lon2);
+      double distance = SloppyMath.haversinMeters(sortKey);
+      if (distance == 0) {
+        continue;
+      }
+      // radius == distance: the point is within the radius
+      assertTrue(
+          "not matched at radius " + distance, sortKey <= GeoUtils.distanceQuerySortKey(distance));
+      // radius one ulp smaller: the point is outside
+      assertTrue(
+          "matched at radius " + Math.nextDown(distance) + ", distance " + distance,
+          sortKey > GeoUtils.distanceQuerySortKey(Math.nextDown(distance)));
+    }
+  }
+
