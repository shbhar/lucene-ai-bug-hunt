+  /** Nikhahit + Sara Aa, or Nikhahit + tone mark + Sara Aa. */
+  private static boolean hasDecomposedSaraAm(char[] s, int len) {
+    for (int i = 0; i + 1 < len; i++) {
+      if (s[i] == '\u0E4D'
