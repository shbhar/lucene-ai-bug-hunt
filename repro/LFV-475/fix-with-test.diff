+  public void testMultiDimPointInSetQueryPointsNotSortedInEveryDim() throws Exception {
+    Directory dir = newDirectory();
+    IndexWriterConfig iwc = newIndexWriterConfig();
+    iwc.setCodec(getCodec());
+    IndexWriter w = new IndexWriter(dir, iwc);
+
+    Document doc = new Document();
+    doc.add(new IntPoint("int", 1, 0));
+    w.addDocument(doc);
+    IndexReader r = DirectoryReader.open(w);
+    IndexSearcher s = newSearcher(r, false);
+
+    assertEquals(1, s.count(newMultiDimIntSetQuery("int", 2, 1, 0)));
+    // (0,1) sorts first, but the set's minimum in the second dimension is 0, not 1
+    assertEquals(1, s.count(newMultiDimIntSetQuery("int", 2, 0, 1, 1, 0)));
+    // (2,-1) sorts last, but the set's maximum in the second dimension is 0, not -1
+    assertEquals(1, s.count(newMultiDimIntSetQuery("int", 2, 1, 0, 2, -1)));
+
+    w.close();
+    r.close();
+    dir.close();
+  }
