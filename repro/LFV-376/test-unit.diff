+  public void testDashInBracketsIntersectingWithStrip() {
+    // "dash hasn't got special meaning": [a-c] is the set {a, -, c} where it overlaps the strip too
+    assertEquals(ALWAYS_FALSE, AffixCondition.compile(SUFFIX, "b", "[a-c]", ""));
+    assertEquals(ALWAYS_FALSE, AffixCondition.compile(PREFIX, "b", "[a-c]", ""));
+    assertTrue(AffixCondition.compile(SUFFIX, "-", "[a-c]", "").acceptsStem("x"));
+    assertTrue(AffixCondition.compile(SUFFIX, "b", "[^a-c]", "").acceptsStem("x"));
+    assertTrue(AffixCondition.compile(PREFIX, "b", "[^a-c]", "").acceptsStem("x"));
+    assertTrue(AffixCondition.compile(SUFFIX, "b", "a[^a-c]", "").acceptsStem("a"));
+    assertTrue(AffixCondition.compile(PREFIX, "b", "[^a-c]a", "").acceptsStem("a"));
+    // not a (reversed) range either
+    assertTrue(AffixCondition.compile(SUFFIX, "a", "[c-a]", "").acceptsStem("x"));
+  }
+
   public void testImpossibleCondition() {
     assertEquals(ALWAYS_FALSE, AffixCondition.compile(SUFFIX, "a", "b", ""));
   }
