+  public void testQuoteInScriptOrStyleComment() throws Exception {
+    // A quote in a JavaScript or CSS comment does not start a string.
+    assertHTMLStripsTo(
+        "one<script><!--\n// Don't remove\nvar x = 1;\n//--></script>two", "one\ntwo", null);
+    assertHTMLStripsTo("one<script><!-- // don't --></script>two", "one\ntwo", null);
+    assertHTMLStripsTo("one<script><!-- /* don't */ --></script>two", "one\ntwo", null);
+    assertHTMLStripsTo(
+        "one<style><!--\n/* Outlook's spacing fix */\np { margin: 0; }\n--></style>two",
+        "one\ntwo",
+        null);
+    assertHTMLStripsTo("one<style><!-- /* a 6\" box */ --></style>two", "one\ntwo", null);
+    // An unterminated string ends at the end of its line.
+    assertHTMLStripsTo("one<script><!--\nvar s = 'it;\n--></script>two", "one\ntwo", null);
+    assertHTMLStripsTo("one<style><!--\np { content: \"x; }\n--></style>two", "one\ntwo", null);
+    // An unterminated block comment ends at "-->".
+    assertHTMLStripsTo("one<style><!-- /* client's fix --></style>two", "one\ntwo", null);
+    assertHTMLStripsTo("one<script><!-- /* don't --></script>two", "one\ntwo", null);
+    // A backslash before a line break (LF or CRLF) continues the string.
+    assertHTMLStripsTo(
+        "one<script><!--\r\nvar s = 'a\\\r\n--> </script>';\r\n--></script>two", "one\ntwo", null);
+    assertHTMLStripsTo(
+        "one<style><!--\r\np { content: \"a\\\r\n--> </style>\"; }\r\n--></style>two",
+        "one\ntwo",
+        null);
+    // Quotes are still tracked in code: a quoted "-->" or "</script>" does not end anything.
+    assertHTMLStripsTo(
+        "one<script><!-- var s = '// -->';\nvar t = \"/* </script> */\"; --></script>two",
+        "one\ntwo",
+        null);
+  }
+
+  public void testEndTagInScriptOrStyleComment() throws Exception {
+    // Outside a string, an end tag closes the element even inside an unterminated "<!--".
+    assertHTMLStripsTo("one<script>a<!--</script>two", "one\ntwo", null);
+    assertHTMLStripsTo("one<script><!-- // x </script>two", "one\ntwo", null);
+    assertHTMLStripsTo("one<style><!-- /* x </STYLE >two", "one\ntwo", null);
+    // Inside a string it still does not (see testScriptQuotes).
+    assertHTMLStripsTo("one<script><!-- f('</script>'); --></script>two", "one\ntwo", null);
+  }
