+  public void testIsTotalWithReachableDeadState() {
+    for (int maxLabel : new int[] {0xff, Character.MAX_CODE_POINT}) {
+      // deterministic, but 'b' leads to a dead state, so "b" is rejected
+      Automaton a = new Automaton();
+      int init = a.createState();
+      int dead = a.createState();
+      a.setAccept(init, true);
+      a.addTransition(init, init, 0, 'a');
+      a.addTransition(init, dead, 'b', 'b');
+      a.addTransition(init, init, 'c', maxLabel);
+      a.finishState();
+      assertTrue(a.isDeterministic());
+      assertTrue(Operations.hasDeadStatesFromInitial(a));
+      assertFalse(Operations.run(a, "b"));
+      assertFalse(Operations.isTotal(a, 0, maxLabel));
+      assertFalse(Operations.isTotal(Operations.removeDeadStates(a), 0, maxLabel));
+    }
+    // a non-accepting state that cannot be reached does not matter
+    Automaton a = new Automaton();
+    int init = a.createState();
+    a.createState();
+    a.setAccept(init, true);
+    a.addTransition(init, init, Character.MIN_CODE_POINT, Character.MAX_CODE_POINT);
+    a.finishState();
+    assertTrue(Operations.isTotal(a));
+  }
