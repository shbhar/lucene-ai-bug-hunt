+  /**
+   * Returns true if deletes or doc-values updates are buffered, or frozen but not yet published, so
+   * that they do not have a delete generation yet.
+   */
+  boolean anyUnpublishedDeletesOrUpdates() {
+    return anyDeletions() || ticketQueue.hasTickets() || pendingChangesInCurrentFullFlush;
+  }
+
+  /**
+   * Freezes the global buffer of deletes and doc-values updates into a flush ticket, like the
+   * RAM-triggered apply does, so that it gets its delete generation when the ticket is published.
+   * Does nothing during a full flush, which freezes the buffer itself.
+   */
+  synchronized void freezeGlobalBuffer() throws IOException {
+    final DocumentsWriterDeleteQueue deleteQueue = this.deleteQueue;
+    if (flushControl.isFullFlush() == false && deleteQueue.isOpen() && deleteQueue.anyChanges()) {
+      ticketQueue.addTicket(() -> maybeFreezeGlobalBuffer(deleteQueue));
+    }
+  }
