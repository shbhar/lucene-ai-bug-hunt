+package org.apache.lucene.codecs.perfield;
+
+import java.io.IOException;
+import org.apache.lucene.codecs.Codec;
+import org.apache.lucene.codecs.PostingsFormat;
+import org.apache.lucene.codecs.lucene104.Lucene104Codec;
+import org.apache.lucene.codecs.simpletext.SimpleTextCodec;
+import org.apache.lucene.document.Document;
+import org.apache.lucene.document.Field;
+import org.apache.lucene.document.StoredField;
+import org.apache.lucene.document.StringField;
+import org.apache.lucene.index.DirectoryReader;
+import org.apache.lucene.index.IndexWriter;
+import org.apache.lucene.index.IndexWriterConfig;
+import org.apache.lucene.index.Term;
+import org.apache.lucene.store.Directory;
+import org.apache.lucene.tests.util.LuceneTestCase;
+
+/**
+ * A field whose documents were all deleted inside a segment written by a codec whose postings
+ * format is not per-field keeps the per-field postings attributes it inherited. A later per-field
+ * merge does not rewrite them, so the merged segment names postings files that were never written
+ * and cannot be opened.
+ */
+public class TestPerFieldPostingsMergeStaleAttributes extends LuceneTestCase {
+
+  /** The default codec, except that field "tag" uses its own postings format (FST50). */
+  private static Codec tagUsesFst50() {
+    return new Lucene104Codec() {
+      final PostingsFormat fst50 = PostingsFormat.forName("FST50");
+
+      @Override
+      public PostingsFormat getPostingsFormatForField(String field) {
+        return field.equals("tag") ? fst50 : super.getPostingsFormatForField(field);
+      }
+    };
+  }
+
+  private static Document doc(String id, String tag) {
+    Document doc = new Document();
+    doc.add(new StringField("id", id, Field.Store.YES));
+    if (tag != null) {
+      doc.add(new StringField("tag", tag, Field.Store.NO));
+    }
+    return doc;
+  }
+
+  private static IndexWriter writer(Directory dir, Codec codec) throws IOException {
+    return new IndexWriter(dir, new IndexWriterConfig().setCodec(codec));
+  }
+
+  /** Three writer sessions; the middle one uses a codec whose postings format is not per-field. */
+  private void deleteTagInMiddleSessionThenMerge(Codec middle) throws IOException {
+    try (Directory dir = newDirectory()) {
+      // Session 1: per-field codec; doc 0 has "tag" (written as FST50, suffix 0), doc 1 has not.
+      try (IndexWriter w = writer(dir, tagUsesFst50())) {
+        w.addDocument(doc("0", "t"));
+        w.addDocument(doc("1", null));
+      }
+      // Session 2: delete the only doc with "tag", add a doc and merge: no "tag" postings are left,
+      // but the merged FieldInfos still say tag = FST50, suffix 0.
+      try (IndexWriter w = writer(dir, middle)) {
+        w.deleteDocuments(new Term("id", "0"));
+        w.addDocument(doc("2", null));
+        w.forceMerge(1);
+      }
+      // Session 3: the per-field codec again. Add a doc and merge everything.
+      try (IndexWriter w = writer(dir, tagUsesFst50())) {
+        w.addDocument(doc("3", null));
+        w.forceMerge(1);
+      }
+      // Every call returned normally, so the committed index must open.
+      try (DirectoryReader r = DirectoryReader.open(dir)) {
+        assertEquals(3, r.numDocs());
+        assertEquals(0, r.docFreq(new Term("tag", "t")));
+      }
+    }
+  }
+
+  public void testFieldWithOwnFormatDeletedInSimpleTextSegment() throws Exception {
+    deleteTagInMiddleSessionThenMerge(new SimpleTextCodec());
+  }
+
+  /** Not specific to SimpleText: the test framework's CheapBastard codec has a plain format too. */
+  public void testFieldWithOwnFormatDeletedInPlainPostingsSegment() throws Exception {
+    deleteTagInMiddleSessionThenMerge(Codec.forName("CheapBastard"));
+  }
+
+  /** The stock default codec only: the final merge has no indexed field left to write. */
+  public void testDefaultCodecNoIndexedFieldLeft() throws Exception {
+    try (Directory dir = newDirectory()) {
+      try (IndexWriter w = writer(dir, new Lucene104Codec())) {
+        Document doc = new Document();
+        doc.add(new StringField("tag", "t", Field.Store.NO));
+        w.addDocument(doc);
+        doc = new Document();
+        doc.add(new StoredField("s", "kept"));
+        w.addDocument(doc);
+      }
+      try (IndexWriter w = writer(dir, new SimpleTextCodec())) {
+        w.deleteDocuments(new Term("tag", "t"));
+        w.forceMerge(1);
+      }
+      try (IndexWriter w = writer(dir, new Lucene104Codec())) {
+        Document doc = new Document();
+        doc.add(new StoredField("s", "added"));
+        w.addDocument(doc);
+        w.forceMerge(1);
+      }
+      try (DirectoryReader r = DirectoryReader.open(dir)) {
+        assertEquals(2, r.numDocs());
+      }
+    }
+  }
+}
