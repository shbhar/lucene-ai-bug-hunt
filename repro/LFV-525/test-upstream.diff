     t.setReader(new StringReader("aba"));
     assertTokenStreamContents(t, new String[] {"a"}, new int[] {2}, new int[] {3}, 3);
   }
+
+  private static Automaton determinized(String regexp) {
+    return Operations.determinize(
+        new RegExp(regexp).toAutomaton(), Operations.DEFAULT_DETERMINIZE_WORK_LIMIT);
+  }
+
+  public void testEndLookaheadWithoutMatch() throws Exception {
+    // the separator lookahead from 'a' reaches the end of the input without a match: retry at 'b'
+    Tokenizer t = new SimplePatternSplitTokenizer(determinized("abc|b"));
+    t.setReader(new StringReader("xab"));
+    assertTokenStreamContents(t, new String[] {"xa"}, new int[] {0}, new int[] {2}, 3);
+
+    // an unclosed '<' must not hide the separators after it
+    t = new SimplePatternSplitTokenizer(determinized("\\<[^\\>]*\\>|[ ]+"));
+    t.setReader(new StringReader("x < y"));
+    assertTokenStreamContents(
+        t, new String[] {"x", "<", "y"}, new int[] {0, 2, 4}, new int[] {1, 3, 5}, 5);
+  }
+
+  public void testManyUnclosedOpeners() throws Exception {
+    Tokenizer t = new SimplePatternSplitTokenizer(determinized("\\<[^\\>]*\\>|[ ]+"));
+    StringBuilder b = new StringBuilder();
+    for (int i = 0; i < 5000; i++) {
+      b.append("< ");
+    }
+    t.setReader(new StringReader(b.toString()));
+    CharTermAttribute termAtt = t.getAttribute(CharTermAttribute.class);
+    t.reset();
+    int count = 0;
+    while (t.incrementToken()) {
+      assertEquals("<", termAtt.toString());
+      count++;
+    }
+    t.end();
+    t.close();
+    assertEquals(5000, count);
+  }
 }
