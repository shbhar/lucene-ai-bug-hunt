+  public void testRangeOverDoubleValuesSource() throws IOException {
+    // values that round to the same float as a bound, or are beyond Float.MAX_VALUE, must be
+    // compared as doubles
+    double[] doubles = {1.0, 1.0000000000000002, 1e301};
+    long[] longs = {1_700_000_000_000L, 1_700_000_060_000L, 1_700_000_120_000L};
+    try (Directory dir = newDirectory()) {
+      try (IndexWriter w = new IndexWriter(dir, newIndexWriterConfig())) {
+        for (int i = 0; i < doubles.length; i++) {
+          Document doc = new Document();
+          doc.add(new DoubleDocValuesField("d", doubles[i]));
+          doc.add(new NumericDocValuesField("l", longs[i]));
+          w.addDocument(doc);
+        }
+      }
+      try (IndexReader reader = DirectoryReader.open(dir)) {
+        IndexSearcher searcher = newSearcher(reader);
+        ValueSource d = ValueSource.fromDoubleValuesSource(DoubleValuesSource.fromDoubleField("d"));
+        ValueSource l = ValueSource.fromDoubleValuesSource(DoubleValuesSource.fromLongField("l"));
+        assertEquals(1, searcher.count(new FunctionRangeQuery(d, 1.0, 1.0, true, true)));
+        assertEquals(2, searcher.count(new FunctionRangeQuery(d, null, 1e300, true, true)));
+        assertEquals(
+            1, searcher.count(new FunctionRangeQuery(l, null, 1_700_000_000_000L, true, true)));
+      }
+    }
+  }
