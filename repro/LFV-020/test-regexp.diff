+  public void testStarOfEmptyLanguageAcceptsEmptyString() {
+    // zero repetitions are always allowed, so the star of the empty language is {""}
+    for (String regexp : new String[] {"#*", "(a&b)*", "(#){0,}"}) {
+      Automaton a =
+          Operations.determinize(
+              new RegExp(regexp).toAutomaton(), Operations.DEFAULT_DETERMINIZE_WORK_LIMIT);
+      assertTrue(regexp + " must accept the empty string", Operations.run(a, ""));
+      assertFalse(regexp + " must accept only the empty string", Operations.run(a, "a"));
+    }
+    Automaton a =
+        Operations.determinize(
+            new RegExp("a(a&b)*").toAutomaton(), Operations.DEFAULT_DETERMINIZE_WORK_LIMIT);
+    assertTrue("a(a&b)* must accept \"a\"", Operations.run(a, "a"));
+  }
+
   boolean caseSensitiveQuery = true;
