+package org.apache.lucene.index;
+
+import java.util.List;
+import org.apache.lucene.document.Field;
+import org.apache.lucene.document.NumericDocValuesField;
+import org.apache.lucene.document.SortedDocValuesField;
+import org.apache.lucene.document.StoredField;
+import org.apache.lucene.document.StringField;
+import org.apache.lucene.document.column.Column;
+import org.apache.lucene.document.column.ColumnBatch;
+import org.apache.lucene.document.column.LongColumn;
+import org.apache.lucene.document.column.LongTupleCursor;
+import org.apache.lucene.search.DocIdSetIterator;
+import org.apache.lucene.store.Directory;
+import org.apache.lucene.tests.util.LuceneTestCase;
+import org.apache.lucene.util.BytesRef;
+
+/**
+ * Field "id" is indexed as a StringField plus a SortedDocValuesField, so its FieldInfo has postings
+ * and sorted doc values. A later document of the same segment that lacks one of the two must be
+ * rejected (per-field consistency, LUCENE-9334). Public API only.
+ */
+public class TestFrozenTypeCacheSchemaCheck extends LuceneTestCase {
+
+  private static Field string(String v) {
+    return new StringField("id", v, Field.Store.NO);
+  }
+
+  private static Field sortedDv(String v) {
+    return new SortedDocValuesField("id", new BytesRef(v));
+  }
+
+  /** Fails on 10.5.0+: the document without doc values is accepted. */
+  public void testDocWithoutDocValuesRejected() throws Exception {
+    try (Directory dir = newDirectory();
+        IndexWriter w = new IndexWriter(dir, new IndexWriterConfig())) {
+      w.addDocument(List.of(string("a"), sortedDv("a")));
+      expectThrows(IllegalArgumentException.class, () -> w.addDocument(List.of(string("b"))));
+    }
+  }
+
+  /** Passes: the same documents, with the doc-values value first in the first document. */
+  public void testDocWithoutDocValuesRejectedDocValuesFirst() throws Exception {
+    try (Directory dir = newDirectory();
+        IndexWriter w = new IndexWriter(dir, new IndexWriterConfig())) {
+      w.addDocument(List.of(sortedDv("a"), string("a")));
+      expectThrows(IllegalArgumentException.class, () -> w.addDocument(List.of(string("b"))));
+    }
+  }
+
+  /**
+   * Fails on 10.5.0+: the second value forces validation, but against the previous document's
+   * schema, which still has the doc values.
+   */
+  public void testDocWithStoredValueButNoDocValuesRejected() throws Exception {
+    try (Directory dir = newDirectory();
+        IndexWriter w = new IndexWriter(dir, new IndexWriterConfig())) {
+      w.addDocument(List.of(string("a"), sortedDv("a")));
+      expectThrows(
+          IllegalArgumentException.class,
+          () -> w.addDocument(List.of(string("b"), new StoredField("id", "b"))));
+    }
+  }
+
+  /** Fails on 10.5.0+: a valid document is rejected after a rejected addBatch. */
+  public void testValidDocAcceptedAfterRejectedBatch() throws Exception {
+    try (Directory dir = newDirectory();
+        IndexWriter w = new IndexWriter(dir, new IndexWriterConfig())) {
+      w.addDocument(List.of(string("a"))); // "id" is a postings-only field
+      LongColumn numeric =
+          new LongColumn("id", NumericDocValuesField.TYPE, Column.Density.SPARSE) {
+            @Override
+            public LongTupleCursor tuples() {
+              return new LongTupleCursor() {
+                int doc = -1;
+
+                @Override
+                public int nextDoc() {
+                  return ++doc == 0 ? 0 : DocIdSetIterator.NO_MORE_DOCS;
+                }
+
+                @Override
+                public long longValue() {
+                  return 1;
+                }
+              };
+            }
+          };
+      ColumnBatch batch =
+          new ColumnBatch() {
+            @Override
+            public int numDocs() {
+              return 1;
+            }
+
+            @Override
+            public Iterable<Column> columns() {
+              return List.of(numeric);
+            }
+          };
+      // correctly rejected: "id" has no doc values
+      expectThrows(IllegalArgumentException.class, () -> w.addBatch(batch));
+      // valid: the same postings as the first document, plus a stored value
+      w.addDocument(List.of(string("b"), new StoredField("id", "b")));
+    }
+  }
+}
