+  /**
+   * Returns true if the squared norm of the provided vector is zero or subnormal (below {@link
+   * Float#MIN_NORMAL}). {@link #cosine(float[], float[])} and the vector formats compute the norm
+   * in float32, so such a vector behaves like the zero vector even if some of its components are
+   * not zero, for example {@code {1e-30f, 0f}}. This requires every component to be smaller than
+   * 2^-63 in magnitude. Returns false if a component is not finite.
+   */
+  public static boolean isZeroOrSubnormalNorm(float[] v) {
+    double squaredNorm = 0;
+    for (float value : v) {
+      if (Math.abs(value) >= 0x1p-63f) {
+        return false; // value * value >= Float.MIN_NORMAL on its own
+      }
+      squaredNorm += (double) value * value;
+    }
+    return squaredNorm < Float.MIN_NORMAL; // false for NaN
+  }
+
