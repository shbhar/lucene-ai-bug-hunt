+  public void testConditionShorterThanStrip() {
+    // the condition lies inside the strip: a suffix condition is checked at the strip's end and a
+    // prefix condition at its start, as for the literal conditions in testUniqueKey
+    assertEquals(ALWAYS_TRUE, AffixCondition.compile(SUFFIX, "abc", "[c]", ""));
+    assertEquals(ALWAYS_TRUE, AffixCondition.compile(SUFFIX, "abc", ".c", ""));
+    assertEquals(ALWAYS_FALSE, AffixCondition.compile(SUFFIX, "abc", "[a]", ""));
+    assertEquals(ALWAYS_TRUE, AffixCondition.compile(PREFIX, "abc", "[a]", ""));
+    assertEquals(ALWAYS_TRUE, AffixCondition.compile(PREFIX, "abc", "a.", ""));
+    assertEquals(ALWAYS_FALSE, AffixCondition.compile(PREFIX, "abc", "[c]", ""));
+  }
