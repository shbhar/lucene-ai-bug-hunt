+  /**
+   * Adds the query analyzed from a run of consecutive plain terms (splitOnWhitespace=false). If the
+   * query is a BooleanQuery with one clause per term position, that is, all its clauses have the
+   * default operator's occur and cover the same fields, they are added one by one, as if the terms
+   * had been parsed separately, so that a following AND/OR still applies to the run's last position
+   * when a term that the analyzer drops sits in between. Clauses are never re-flagged, and a
+   * per-field disjunction (MultiFieldQueryParser, one position) is not split: any other query is
+   * added as a single clause.
+   */
+  void addMultiTermRunClauses(List<BooleanClause> clauses, Query q) {
+    if (q instanceof BooleanQuery bq
+        && bq.getMinimumNumberShouldMatch() == 0
+        && bq.clauses().isEmpty() == false) {
+      Occur defaultOccur = operator == OR_OPERATOR ? Occur.SHOULD : Occur.MUST;
+      Set<String> fields = fieldsOf(bq.clauses().get(0).query());
+      boolean positions = true;
+      for (BooleanClause clause : bq.clauses()) {
+        if (clause.occur() != defaultOccur || fields.equals(fieldsOf(clause.query())) == false) {
+          positions = false;
+          break;
+        }
+      }
+      if (positions) {
+        clauses.addAll(bq.clauses());
+        return;
+      }
+    }
+    addClause(clauses, CONJ_NONE, MOD_NONE, q);
+  }
+
+  private static Set<String> fieldsOf(Query q) {
+    Set<String> fields = new HashSet<>();
+    q.visit(
+        new QueryVisitor() {
+          @Override
+          public boolean acceptField(String field) {
+            fields.add(field);
+            return true;
+          }
+        });
+    return fields;
+  }
