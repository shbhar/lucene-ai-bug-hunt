+  /**
+   * Publishes the segments that addIndexes copied or merged, at a full-flush boundary, the same way
+   * {@link #prepareCommit} cuts a commit point. Every delete and update buffered so far, including
+   * the ones that arrived while the segments were copied or merged, has a smaller sequence number
+   * than this call: the full flush gives them their delete generation first, and the added segments
+   * get the next one, so those packets skip the added segments while later ones apply to them.
+   * Holding {@code fullFlushLock} also orders the publication against a concurrent commit or NRT
+   * reader. Returns the boundary as this call's sequence number.
+   */
+  private long publishAddedSegments(List<SegmentCommitInfo> infos, long totalDocs)
+      throws IOException {
+    assert Thread.holdsLock(this) == false;
+    if (infoStream.isEnabled("IW")) {
+      infoStream.message("IW", "addIndexes: flush and publish " + infos.size() + " segments");
+    }
+    boolean published = false;
+    try {
+      doBeforeFlush();
+      testPoint("startDoFlush");
+      synchronized (fullFlushLock) {
+        boolean flushSuccess = false;
+        try {
+          long seqNo = docWriter.flushAllThreads();
+          if (seqNo < 0) {
+            seqNo = -seqNo;
+          } else {
+            // flushCount is incremented in flushAllThreads only if it flushed something
+            flushCount.incrementAndGet();
+          }
+          publishFlushedSegments(true);
+          flushSuccess = true;
+          synchronized (this) {
+            ensureOpen();
+            if (infos.isEmpty() == false) {
+              // Now reserve the docs, just before we update SIS:
