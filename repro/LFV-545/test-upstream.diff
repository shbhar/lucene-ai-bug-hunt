+
+  /** A failed attempt at a supplementary character must retry at the next code point. */
+  public void testFailedAttemptAtSupplementaryCharacter() throws Exception {
+    String fire = new String(Character.toChars(0x1F525)); // two UTF-16 units
+    Tokenizer t = new SimplePatternTokenizer(fire + "[0-9]+|[^" + fire + " ]+");
+    t.setReader(new StringReader(fire + "hot deal"));
+    assertTokenStreamContents(
+        t, new String[] {"hot", "deal"}, new int[] {2, 6}, new int[] {5, 10}, 10);
+    t.setReader(new StringReader(fire + " x"));
+    assertTokenStreamContents(t, new String[] {"x"}, new int[] {3}, new int[] {4}, 4);
+  }
