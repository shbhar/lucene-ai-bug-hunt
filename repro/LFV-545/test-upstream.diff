+
+  /** A failed separator attempt at a supplementary character must retry at the next code point. */
+  public void testFailedAttemptAtSupplementaryCharacter() throws Exception {
+    String fire = new String(Character.toChars(0x1F525)); // two UTF-16 units
+    Tokenizer t = new SimplePatternSplitTokenizer("[^a-z" + fire + "]+|" + fire + "!");
+    t.setReader(new StringReader("so" + fire + "hot now"));
+    assertTokenStreamContents(
+        t, new String[] {"so" + fire + "hot", "now"}, new int[] {0, 8}, new int[] {7, 11}, 11);
+  }
 }
