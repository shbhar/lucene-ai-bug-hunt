+package org.apache.lucene.queries.spans;
+
+import java.io.IOException;
+import org.apache.lucene.index.PostingsEnum;
+import org.apache.lucene.index.Term;
+import org.apache.lucene.util.ArrayUtil;
+import org.apache.lucene.util.BytesRef;
+
+/**
+ * Records the leaves that a {@link Spans} collects at some of its positions (term, position, doc,
+ * freq, offsets, payload), so that they can be replayed into a {@link SpanCollector} after the
+ * Spans has moved on. The replayed {@link PostingsEnum} reports the recorded doc and freq of the
+ * original postings, so collectors that size buffers by {@code freq()} behave as with the live
+ * postings. Used by the containment queries, which may decide a match only after the partner span
+ * that makes it a match has been passed.
+ */
+final class SpanLeafRecorder implements SpanCollector {
+  private Term[] terms = new Term[4];
+  private int[] positions = new int[4];
+  private int[] docs = new int[4];
+  private int[] freqs = new int[4];
+  private int[] startOffsets = new int[4];
+  private int[] endOffsets = new int[4];
+  private BytesRef[] payloads = new BytesRef[4];
+  private int[] spanEnds = new int[4]; // leaves of span i are [spanEnds[i-1], spanEnds[i])
+  private int numLeaves;
+  private int numSpans;
+
+  void clear() {
+    numLeaves = 0;
+    numSpans = 0;
+  }
+
+  /** Records the leaves of the current position of {@code spans} as the next span. */
+  void record(Spans spans) throws IOException {
+    spans.collect(this);
+    spanEnds = ArrayUtil.grow(spanEnds, numSpans + 1);
+    spanEnds[numSpans++] = numLeaves;
+  }
+
+  @Override
+  public void collectLeaf(PostingsEnum postings, int position, Term term) throws IOException {
+    if (numLeaves == terms.length) {
+      int newLength = ArrayUtil.oversize(numLeaves + 1, Integer.BYTES);
+      terms = ArrayUtil.growExact(terms, newLength);
+      positions = ArrayUtil.growExact(positions, newLength);
+      docs = ArrayUtil.growExact(docs, newLength);
+      freqs = ArrayUtil.growExact(freqs, newLength);
+      startOffsets = ArrayUtil.growExact(startOffsets, newLength);
+      endOffsets = ArrayUtil.growExact(endOffsets, newLength);
+      payloads = ArrayUtil.growExact(payloads, newLength);
+    }
+    terms[numLeaves] = term;
+    positions[numLeaves] = position;
+    docs[numLeaves] = postings.docID();
+    freqs[numLeaves] = postings.freq();
+    startOffsets[numLeaves] = postings.startOffset();
+    endOffsets[numLeaves] = postings.endOffset();
+    BytesRef payload = postings.getPayload();
+    payloads[numLeaves] = payload == null ? null : BytesRef.deepCopyOf(payload);
+    numLeaves++;
+  }
+
+  @Override
+  public void reset() {}
+
+  /** Replays the leaves recorded for span number {@code span} into {@code collector}. */
+  void replay(int span, SpanCollector collector) throws IOException {
+    int from = span == 0 ? 0 : spanEnds[span - 1];
+    for (int i = from; i < spanEnds[span]; i++) {
+      collector.collectLeaf(new RecordedLeaf(i), positions[i], terms[i]);
+    }
+  }
+
+  private final class RecordedLeaf extends PostingsEnum {
+    private final int leaf;
+
+    RecordedLeaf(int leaf) {
+      this.leaf = leaf;
+    }
+
+    @Override
+    public int freq() {
+      return freqs[leaf];
+    }
+
+    @Override
+    public int nextPosition() {
+      return positions[leaf];
+    }
+
+    @Override
+    public int startOffset() {
+      return startOffsets[leaf];
+    }
+
+    @Override
+    public int endOffset() {
+      return endOffsets[leaf];
+    }
+
+    @Override
+    public BytesRef getPayload() {
+      return payloads[leaf];
+    }
+
+    @Override
+    public int docID() {
+      return docs[leaf];
+    }
+
+    @Override
+    public int nextDoc() {
+      throw new UnsupportedOperationException();
+    }
+
+    @Override
+    public int advance(int target) {
+      throw new UnsupportedOperationException();
+    }
+
+    @Override
+    public long cost() {
+      return 1;
+    }
+  }
+}
