+  /** The start state accepts and has a transition: "" must still be returned only once. */
+  public void testEmptyStringReturnedOnce() {
+    List<Automaton> automata =
+        List.of(
+            new RegExp("a?").toAutomaton(),
+            Automata.makeStringUnion(
+                List.of(
+                    new BytesRef(""), new BytesRef("a"), new BytesRef("ab"), new BytesRef("b"))));
+    for (Automaton a : automata) {
+      assertTrue(a.isDeterministic());
+      List<IntsRef> actual = getFiniteStrings(new FiniteStringsIterator(a));
+      assertEquals(
+          "no string is returned twice: " + actual, new HashSet<>(actual).size(), actual.size());
+      assertTrue(actual.contains(new IntsRef()));
+    }
+  }
+
+  /** The paths that start at state 1 of 0 -x-> 1 (accept) -a-> 2 (accept) are "" and "a". */
+  public void testEmptyStringFromAcceptingStartStateOtherThanZero() {
+    Automaton a = new Automaton();
+    int s0 = a.createState();
+    int s1 = a.createState();
+    int s2 = a.createState();
+    a.setAccept(s1, true);
+    a.setAccept(s2, true);
+    a.addTransition(s0, s1, 'x');
+    a.addTransition(s1, s2, 'a');
+    a.finishState();
+    List<IntsRef> actual = getFiniteStrings(new FiniteStringsIterator(a, s1, -1));
+    assertEquals(2, actual.size());
+    assertTrue(actual.contains(new IntsRef()));
+  }
+
