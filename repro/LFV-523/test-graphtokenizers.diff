+  public void testEmptyToken() throws Exception {
+    final TokenStream ts =
+        new CannedTokenStream(
+            new Token[] {
+              token("abc", 1, 1), token("", 1, 1), token("def", 1, 1),
+            });
+    final Automaton actual = new TokenStreamToAutomaton().toAutomaton(ts);
+    assertFalse("the path through the empty token is lost", Operations.isEmpty(actual));
+    // a zero-length token keeps its position, like a hole
+    assertSameLanguage(join(s2a("abc"), SEP_A, HOLE_A, SEP_A, s2a("def")), actual);
+  }
+
+  public void testStackedEmptyToken() throws Exception {
+    final TokenStream ts =
+        new CannedTokenStream(
+            new Token[] {
+              token("abc", 1, 1), token("xyz", 1, 1), token("", 0, 1), token("def", 1, 1),
+            });
+    final Automaton a1 = join(s2a("abc"), SEP_A, s2a("xyz"), SEP_A, s2a("def"));
+    final Automaton a2 = join(s2a("abc"), SEP_A, HOLE_A, SEP_A, s2a("def"));
+    assertSameLanguage(Operations.union(List.of(a1, a2)), ts);
+  }
+
+  public void testOnlyEmptyTokens() throws Exception {
+    final TokenStream ts =
+        new CannedTokenStream(
+            new Token[] {
+              token("", 1, 1), token("", 1, 1),
+            });
+    // like a stream with no tokens
+    assertTrue(Operations.isEmpty(new TokenStreamToAutomaton().toAutomaton(ts)));
+  }
